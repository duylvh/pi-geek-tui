{
  "name": "@sting8k/pi-geek-tui",
  "version": "0.1.0",
  "description": "Hancore-inspired geek terminal UI for Pi: gutter timestamps, rail, tool trees, two-line stats footer.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "*.ts",
    "core/",
    "editor/",
    "messages/",
    "performance/",
    "presentation/",
    "theme/",
    "tool-tags/",
    "user-zone/",
    "widgets/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "pi-geek-tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sting8k/pi-geek-tui.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:link": "npm install",
    "dev:clean": "rm -rf node_modules",
    "typecheck": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck --noImplicitAny false index.ts",
    "test": "npm run test:working-message && npm run test:startup-resources && npm run test:core-message-blocks && npm run test:tasks-widget-compact && npm run test:reasonix-conversation && npm run test:collapsed-thinking && npm run test:presentation-buffer && npm run test:session-resume-styling && npm run test:tui-proxy && npm run test:builtin-tool-renderers && npm run test:geek-rows",
    "check": "npm run typecheck && npm test && npm pack --dry-run",
    "profile:render": "node scripts/render-profile-bench.mjs",
    "trace:pi": "node scripts/pi-trace.mjs",
    "debug:render-log": "node scripts/render-frame-log-summary.mjs",
    "test:working-message": "node scripts/working-message-config-smoke.mjs",
    "test:startup-resources": "node scripts/startup-resources-smoke.mjs",
    "test:core-message-blocks": "node scripts/core-message-blocks-smoke.mjs",
    "test:tasks-widget-compact": "node scripts/tasks-widget-compact-smoke.mjs",
    "test:reasonix-conversation": "node scripts/reasonix-conversation-smoke.mjs",
    "test:collapsed-thinking": "node scripts/collapsed-thinking-smoke.mjs",
    "test:presentation-buffer": "node scripts/presentation-buffer-smoke.mjs",
    "test:session-resume-styling": "node scripts/session-resume-styling-smoke.mjs",
    "test:tui-proxy": "node scripts/tui-proxy-recursion-smoke.mjs",
    "test:builtin-tool-renderers": "node scripts/builtin-tool-renderers-smoke.mjs",
    "test:geek-rows": "node scripts/geek-rows-smoke.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/sting8k/pi-geek-tui/main/screenshots/image.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.78.0 <2.0.0",
    "@earendil-works/pi-tui": ">=0.78.0 <2.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@earendil-works/pi-tui": "^0.78.0",
    "typescript": "^6.0.3"
  }
}
